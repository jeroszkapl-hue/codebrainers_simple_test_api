            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "PUT Update Employee",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Jan Kowalski\",\n  \"salary\": 12000,\n  \"age\": 31,\n  \"position\": \"Senior QA\",\n  \"on_leave\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "employees", "{{employeeId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Employee was updated correctly', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.salary).to.eql(12000);",
              "    pm.expect(json.age).to.eql(31);",
              "    pm.expect(json.position).to.eql('Senior QA');",
              "    pm.expect(json.on_leave).to.eql(true);",
              "});",
              "",
              "pm.test('ID did not change after update', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(String(json.id)).to.eql(pm.collectionVariables.get('employeeId').toString());",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
