            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Piotr Wiśniewski\",\n  \"salary\": 999999,\n  \"age\": 35,\n  \"position\": \"Senior QA\",\n  \"on_leave\": false\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/employees",
