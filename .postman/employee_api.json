              "});",
              "",
              "pm.test('Response contains Employee not found message', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.detail).to.eql('Employee not found');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
